{
  "name": "erp",
  "version": "0.0.1",
  "description": "ERP System for SME",
  "author": "Amaan Sayyed",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -- jest",
    "test:watch": "cross-env NODE_ENV=test dotenv -e .env.test -- jest --watch",
    "test:cov": "cross-env NODE_ENV=test dotenv -e .env.test -- jest --coverage",
    "test:debug": "cross-env NODE_ENV=test dotenv -e .env.test -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test dotenv -e .env.test -- jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "cross-env NODE_ENV=test dotenv -e .env.test -- jest --config ./test/jest-integration.json --runInBand",
    "test:unit": "cross-env NODE_ENV=test dotenv -e .env.test -- jest --config ./test/jest-unit.json",
    "prisma:build": "node scripts/merge-prisma.js",
    "prisma:format": "npm run prisma:build && prisma format",
    "prisma:validate": "npm run prisma:build && prisma validate",
    "prisma:generate": "npm run prisma:build && prisma generate",
    "prisma:migrate": "npm run prisma:build && prisma migrate dev",
    "prisma:migrate:dev": "npm run prisma:build && prisma migrate dev",
    "prisma:migrate:deploy": "npm run prisma:build && prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "prisma:seed": "ts-node test/seeds/realistic-data.seed.ts",
    "prisma:push:safe": "ts-node scripts/safe-prisma.ts db push",
    "prisma:reset:safe": "ts-node scripts/safe-prisma.ts migrate reset",
    "postinstall": "npm run prisma:generate",
    "postman:generate": "tsx scripts/generate-postman.ts",
    "postman:generate:watch": "nodemon --watch src --exec pnpm postman:generate",
    "generate:postman": "pnpm postman:generate",
    "generate:postman:watch": "pnpm postman:generate:watch",
    "prepare": "cd .. && husky backend/.husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "axios": "^1.16.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "openapi-to-postmanv2": "^6.0.1",
    "prettier": "^3.4.2",
    "prisma": "5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "@/generated/client": "<rootDir>/prisma/generated",
      "@prisma/client": "<rootDir>/prisma/generated",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm|uuid)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

/// Where a sequence's uniqueness and counter live.
///
/// Identity numbers (`STUDENT_CODE`, `EMPLOYEE_CODE`) are ORGANIZATION-scoped so
/// they survive a branch transfer; operational numbers are BRANCH-scoped because
/// their meaning is local to the branch that issued them.
enum SequenceScope {
  ORGANIZATION
  BRANCH
}

/// How strongly a sequence guarantees continuity.
///
/// MONOTONIC allocates in its own short transaction and commits immediately, so
/// a caller that later rolls back burns the number and leaves a gap. Gaps in a
/// student code are cosmetic; the absence of contention is not.
///
/// GAPLESS allocates inside the caller's transaction and rolls back with it, so
/// the counter row stays locked until the caller commits. That serialises the
/// purpose for its scope, which is the correct price for a receipt or invoice
/// series an auditor will check for continuity.
enum AllocationMode {
  MONOTONIC
  GAPLESS
}

/// The closed set of business identifiers this engine issues.
///
/// An enum rather than a free string: a typo previously created a second,
/// silently parallel sequence rather than failing.
enum SequencePurpose {
  STUDENT_CODE
  EMPLOYEE_CODE
  ADMISSION_NO
  ADMISSION_FORM
  APPLICATION
  RECEIPT
  INVOICE
  TC_NUMBER
  CERTIFICATE
}

/// Whether a sequence restarts each academic year.
///
/// NEVER keeps one counter for the life of the tenant and is what makes an
/// identity number permanent. YEARLY keys the counter on the academic year.
enum ResetStrategy {
  NEVER
  YEARLY
}

/// How the `{year}` placeholder renders, when a format uses one.
///
/// This is independent of `resetStrategy` (§ counter reset) and of
/// `includeAcademicYear` (§ whether a year appears at all) — it only answers
/// *what the digits look like*, given that an AcademicYear has already been
/// chosen for the allocation. Deliberately not derived from `AcademicYear.name`
/// for every mode: that field is admin-typed free text ("2025-26", "2026-2027"
/// both exist in this codebase's own data) with no guaranteed shape, so a
/// format expecting a fixed width would silently misrender the day an academic
/// year is named differently. Every mode but `NAME` computes from
/// `AcademicYear.startDate`/`endDate` instead, which is authoritative and
/// fixed-shape by construction.
///
/// - `NAME`         — `AcademicYear.name` verbatim. The only mode with no
///                     guaranteed width; kept as the default so every sequence
///                     provisioned before this enum existed renders exactly as
///                     it always has.
/// - `FULL_START`   — the starting year, four digits: `2026`.
/// - `SHORT_START`  — the starting year, two digits: `26`.
/// - `FULL_RANGE`   — both years, eight digits: `20262027`.
/// - `SHORT_RANGE`  — both years, four digits: `2627`.
enum SequenceYearFormat {
  NAME
  FULL_START
  SHORT_START
  FULL_RANGE
  SHORT_RANGE
}

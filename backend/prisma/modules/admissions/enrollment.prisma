/// One academic year of study.
///
/// PHASE 0 SHAPE. This is the de-risked form, not the final one: the fields
/// that make placement history representable — `studentId`, `admissionId`,
/// `originType`, `previousEnrollmentId`, `supersededById`, `changeReason`,
/// `version`, and the composite foreign key to Admission — arrive in Phase 4,
/// once Student and Admission exist to reference. See §18.
///
/// What changed here, and why it could not wait for Phase 4:
///
///   * `applicantId` was `@unique`, which meant **one enrollment per applicant
///     for life**. A twelve-year school career was unrepresentable and
///     promotion was impossible.
///   * `applicantId` cascaded on delete, so removing an applicant destroyed the
///     academic record. The database permitted exactly what the domain forbids.
///   * `futureStudentId` was a placeholder column pointing at no table.
model Enrollment {
  id               String  @id @default(uuid(7))
  organizationId   String
  branchId         String
  academicYearId   String
  programId        String
  academicUnitId   String
  /// Provenance only, and nullable: an enrollment created by promotion has no
  /// applicant. **No cascade** — an applicant's lifecycle must never reach the
  /// academic record.
  applicantId      String?
  rollNumber       String?
  enrollmentStatus String // ACTIVE, PROMOTED, COMPLETED, CANCELLED — becomes an enum in Phase 4

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  applicant    Applicant?   @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  academicUnit AcademicUnit @relation(fields: [academicUnitId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([academicYearId])
  @@index([programId])
  @@index([academicUnitId])
  @@index([applicantId])
}

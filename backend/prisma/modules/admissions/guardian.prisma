model Guardian {
  id              String                     @id @default(uuid(7))
  organizationId  String
  branchId        String

  /// Links this guardian-domain profile to the canonical human identity.
  /// Nullable: resolving a Person requires a DOB, which this record has
  /// never collected, so most existing and many new Guardian rows have none.
  /// Set at create() when the caller supplies `dob`, or later at update().
  /// See docs/planning/core-admission-lifecycle-specification.md §8.5 — the
  /// target says `personId` is required; it is nullable here because that
  /// target did not account for the missing DOB collection point.
  personId        String?

  // Identity
  firstName       String
  middleName      String?
  lastName        String

  // Contact
  mobilePrimary   String
  mobileSecondary String?
  email           String?

  // Professional
  occupation      String?
  income          Float?

  // Government
  aadhaarNo       String?

  // Address
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String?
  pincode         String?

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  deletedAt       DateTime?

  applicants      ApplicantGuardianMapping[]
  branch          Branch                     @relation(fields: [branchId], references: [id])
  organization    Organization               @relation(fields: [organizationId], references: [id])
  person          Person?                    @relation(fields: [personId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([mobilePrimary])
  @@index([aadhaarNo])
  @@index([personId])
}

model ApplicantGuardianMapping {
  id                  String       @id @default(uuid(7))
  applicantId         String
  guardianId          String
  relationTypeId      String
  isPrimary           Boolean      @default(false)
  isEmergencyContact  Boolean      @default(false)
  isFinancialGuardian Boolean      @default(false)
  pickupAllowed       Boolean      @default(true)
  priority            Int          @default(1)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  applicant           Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  guardian            Guardian     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationType        RelationType @relation(fields: [relationTypeId], references: [id])

  @@unique([applicantId, guardianId])
  @@index([applicantId])
  @@index([guardianId])
  @@index([relationTypeId])
}

model NumberSequenceConfig {
  id                  String   @id @default(uuid())
  organizationId      String
  branchId            String
  purpose             String   // e.g. "ADMISSION_FORM", "APPLICATION", "STUDENT_CODE", "RECEIPT"
  prefix              String?
  suffix              String?
  includeBranchCode   Boolean  @default(false)
  includeAcademicYear Boolean  @default(false)
  sequencePadding     Int      @default(4)
  format              String   // e.g., "{prefix}-{branchCode}-{year}-{sequence}"
  resetStrategy       String   @default("NEVER") // "YEARLY", "NEVER"
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  counters            NumberSequenceCounter[]

  @@unique([branchId, purpose])
  @@index([organizationId])
  @@index([branchId])
}

model NumberSequenceCounter {
  id             String               @id @default(uuid())
  configId       String
  academicYearId String?
  currentValue   Int                  @default(0)
  updatedAt      DateTime             @updatedAt

  config         NumberSequenceConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, academicYearId])
  @@index([configId])
}

// --- FROM: modules/documents/document.prisma ---

/// R5 — Document Management foundation.
///
/// ## Current state before this phase
///
/// `VERIFIED` against the schema and git history: no `Document`,
/// `DocumentVersion`, `DocumentType`, `DocumentRequirement`, `File` or
/// `Attachment` model existed. `Applicant.photoFileId` and
/// `Student.photoDocumentId` were (and `photoDocumentId` remains,
/// deliberately, with no FK) dangling references. See
/// docs/planning/core-admission-lifecycle-specification.md §11.
///
/// ## Document vs Version
///
/// `Document` is business identity: what it is, who it belongs to, its
/// current state. `DocumentVersion` is one uploaded file: storage
/// reference, scan result, verification result. A document is never
/// overwritten — a replacement is a new, append-only `DocumentVersion` row,
/// and `Document.currentVersionId` is the single pointer that decides which
/// one is in force. Because that pointer is a nullable **unique** foreign
/// key, "at most one current version" is structural, not a constraint that
/// could be forgotten.
///
/// ## Ownership — polymorphic by necessity, not by convenience
///
/// A normal SQL foreign key cannot point at "whichever table `ownerType`
/// names", so referential integrity for `(ownerType, ownerId)` is a SERVICE
/// invariant: `DocumentService` resolves and scope-checks the owner row
/// inside the same transaction, before the Document row is written, using
/// the caller's own verified scope — never a scope value taken from the
/// request body. Orphaning on owner deletion is not a practical risk today
/// because every owner table in this schema is soft-deleted
/// (`deletedAt`) or, for Person, never deleted at all.
///
/// `Employee` (S4) and a distinct `Guardian` owner type are deliberately
/// absent: S4 does not exist yet, and a guardian's documents are owned by
/// their own `Person` row per §11.3 ("Guardian ID proof → PERSON").
enum DocumentOwnerType {
  PERSON
  APPLICANT
  ADMISSION
  ENROLLMENT
  STUDENT
  ORGANIZATION
  BRANCH
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

/// `FAILED` must never be treated as `CLEAN` — a scanner that is down is a
/// reason to refuse the version, not to wave it through. Only `CLEAN` can
/// ever become `Document.currentVersionId`.
enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// Re-verification is required on every new version: a `DocumentVersion`
/// always starts `PENDING`, never inherits the previous version's status.
enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Configurable document types. Same visibility shape as the Admissions
/// masters (Religion, Caste, ...): system default (`organizationId` and
/// `branchId` both null), organization default (`branchId` null), or
/// branch-specific.
model DocumentType {
  id             String  @id @default(uuid(7))
  organizationId String?
  branchId       String?
  code           String
  name           String
  description    String?

  /// Aadhaar, income and similar — drives the stricter download role check
  /// in `DocumentService` (§14 of the spec).
  isSensitive Boolean @default(false)

  hasExpiry             Boolean @default(false)
  /// Only meaningful when `hasExpiry`. Drives `Document.expiresAt` at
  /// upload/replace time.
  defaultValidityMonths Int?

  /// Years to retain after the owning admission/enrollment closes. Read by
  /// a future retention sweep — no sweep exists yet (§19, DEFERRED).
  retentionYears Int?

  /// Content-Type values accepted at upload. Enforced against the
  /// client-declared type AND, for the types this deployment can sniff
  /// (PDF/JPEG/PNG), against the file's own magic bytes.
  allowedMimeTypes String[]
  maxSizeBytes     Int      @default(10485760)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  requirements DocumentRequirement[]
  documents    Document[]

  @@unique([organizationId, branchId, code])
  @@unique([organizationId, branchId, name])
  @@index([organizationId])
  @@index([branchId])
}

/// The rule that a file must exist — distinct from `Document`, which is a
/// file that does. §11.2: this is the table that was missing, which is why
/// `DOCUMENT_PENDING` had nothing to compute against.
///
/// Variance is `programId × quotaId × categoryId` (null = applies to all).
/// `Applicant` carries no `admissionType` column today — `VERIFIED` against
/// `applicant.prisma` — so that axis from the spec's §11.2 formula is not
/// implemented; adding it would mean inventing a field on Applicant, which
/// is out of R5's scope. Recorded as a discrepancy, not silently dropped.
model DocumentRequirement {
  id             String  @id @default(uuid(7))
  organizationId String
  /// Null = applies organization-wide across every branch.
  branchId       String?

  documentTypeId String

  appliesToProgramId  String?
  appliesToQuotaId    String?
  appliesToCategoryId String?

  /// Which `AdmissionApplicationStatus` demands this document. Reuses the
  /// workflow's own enum rather than a parallel one, so a stage that stops
  /// existing cannot leave an orphaned requirement definition silently valid.
  requiredByStage AdmissionApplicationStatus

  isMandatory Boolean @default(true)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  documentType DocumentType  @relation(fields: [documentTypeId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  program      Program?      @relation(fields: [appliesToProgramId], references: [id])
  quota        Quota?        @relation(fields: [appliesToQuotaId], references: [id])
  category     Category?     @relation(fields: [appliesToCategoryId], references: [id])

  @@index([organizationId, branchId])
  @@index([documentTypeId])
  @@index([appliesToProgramId])
  @@index([appliesToQuotaId])
  @@index([appliesToCategoryId])
}

model Document {
  id             String @id @default(uuid(7))
  organizationId String

  /// Null for owners that are organization-scoped for life (`PERSON`,
  /// `STUDENT` — a Student's branch moves, see `student.prisma` — and
  /// `ORGANIZATION`). Set for owners fixed to one branch forever
  /// (`APPLICANT`, `ADMISSION`, `ENROLLMENT`, `BRANCH`). Stamped from the
  /// resolved owner row, never from client input.
  branchId String?

  ownerType DocumentOwnerType
  ownerId   String

  documentTypeId String

  status DocumentStatus @default(ACTIVE)

  /// The version in force. Null until a `CLEAN` version exists.
  currentVersionId String? @unique

  /// Derived from the current version's `uploadedAt` plus
  /// `DocumentType.defaultValidityMonths`; recomputed on replace. An expired
  /// document does not block anything by itself (§11.5) — it is an
  /// administrative fact, not a workflow gate.
  expiresAt DateTime?

  archivedAt    DateTime?
  archivedBy    String?
  archiveReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentType   DocumentType      @relation(fields: [documentTypeId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  currentVersion DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])
  versions       DocumentVersion[] @relation("DocumentVersions")

  /// At most one ACTIVE document per owner+type — a second upload of the
  /// same type for the same owner is a new VERSION, not a new Document.
  /// Partial (`WHERE status = 'ACTIVE'`), hand-written in the migration, so
  /// an archived document does not block a fresh one from starting.
  @@index([organizationId, ownerType, ownerId])
  @@index([documentTypeId])
  @@index([branchId])
  @@index([status])
}

model DocumentVersion {
  id         String @id @default(uuid(7))
  documentId String

  /// 1-based, append-only. `@@unique([documentId, versionNumber])` is what
  /// makes two concurrent replacements produce one winner and one 409
  /// rather than two versions silently sharing a number.
  versionNumber Int

  /// Infrastructure metadata — never a domain concept. `storageProvider`
  /// names which adapter wrote this version (`local` today), so a future
  /// migration to a cloud provider can carry old versions' keys forward
  /// under the adapter that can still resolve them.
  storageProvider  String
  storageKey       String
  /// Display only. Never used to derive `storageKey` — that is generated,
  /// which is what rules out path traversal from a crafted filename.
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String

  /// Which generation of the organization's data key encrypted this
  /// version's bytes at rest, mirroring `PersonSensitive`/`Address` — see
  /// `IdentityCryptoService`.
  encryptionKeyVersion Int

  scanStatus      DocumentScanStatus @default(PENDING)
  scanCompletedAt DateTime?
  scanDetails     String?

  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?

  uploadedBy   String?
  uploadedAt   DateTime  @default(now())
  /// Set the instant a later version supersedes this one. Never null'd back.
  supersededAt DateTime?

  document   Document  @relation("DocumentVersions", fields: [documentId], references: [id])
  /// The reverse of `Document.currentVersionId` — lets a version be found
  /// from "am I the current one" without a second query.
  currentFor Document? @relation("CurrentDocumentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([checksumSha256])
}


// --- FROM: modules/enrollment/enrollment.enums.prisma ---

/// Whether this placement is the student's main one for the year.
///
/// `PRIMARY` is the only kind Phase 4 creates. `SECONDARY` exists for NEP
/// multidisciplinary enrolment and `EXCHANGE` for visiting placements; both are
/// declared now because the partial unique index that limits a student to one
/// live `PRIMARY` per year has to name the kind it applies to, and a value added
/// later would silently widen an index that already exists.
enum EnrollmentKind {
  PRIMARY
  SECONDARY
  EXCHANGE
}

/// The life of one academic-year placement.
///
/// Deliberately **without** `SUSPENDED`. Suspension is a property of the human,
/// not of the placement: a suspended student still occupies their seat in 9-A,
/// and duplicating the state here would leave two aggregates disagreeing about
/// the same fact. A whole year away is `ON_BREAK` on the enrolment plus
/// `ON_HOLD` on the admission.
enum EnrollmentStatus {
  /// Created, not yet in effect.
  PENDING
  /// The current placement.
  ACTIVE
  /// Paused for the year; the seat is retained.
  ON_BREAK
  /// Finished the year and moved up. Historical.
  PROMOTED
  /// Finished the year and repeats it. Historical.
  DETAINED
  /// Finished a terminal year. Historical.
  COMPLETED
  /// Placement moved elsewhere. Historical.
  TRANSFERRED
  /// The student left mid-year. Historical.
  DROPPED_OUT
  /// Voided. Historical.
  CANCELLED
  /// Replaced by a corrected row, which names this one. Historical.
  SUPERSEDED
}

/// Why this placement row exists.
///
/// Recorded rather than inferred. Timestamps cannot tell a correction from a
/// genuine mid-year move, and that is exactly the question asked when a
/// registrar is challenged about a student appearing in two classes.
enum EnrollmentOriginType {
  /// The first placement, written by `admit()`.
  ADMISSION
  /// Next year, next level.
  PROMOTION
  /// Next year, same level.
  REPEAT
  /// An operator's mistake, put right.
  CORRECTION
  /// A real mid-year move within the branch.
  TRANSFER
  /// A new spell of study for a returning student.
  READMISSION
  /// Imported from a previous system.
  MIGRATION
}

/// How the academic year ended for this placement.
///
/// **Enrollment owns the column; Examination owns the decision** (INV-ENR-013).
/// Nothing in this module writes it, and there is no route that can.
///
/// Three values, not a grading vocabulary. The blueprint specifies the column
/// but not its domain, so this carries only what the placement lifecycle itself
/// already distinguishes — `PASS` leads to `PROMOTED` or `COMPLETED`, `FAIL` to
/// `DETAINED`, and `WITHHELD` to neither yet. A richer result vocabulary
/// (grades, divisions, subject-wise outcomes) belongs to Examination's own
/// tables, not here.
enum EnrollmentResultOutcome {
  PASS
  FAIL
  WITHHELD
}


// --- FROM: modules/enrollment/enrollment.prisma ---

/// One academic-year placement.
///
/// The spine of the academic year, and the row that attendance, examination,
/// fees and the timetable will hang off. It answers exactly one question:
/// *where is this learner placed, for this year?*
///
/// ## The test every field had to pass
///
/// *What does this fact vary with?* A fact that changes when the student is
/// promoted belongs here. A fact true of the human for life belongs to Student
/// or Person. A fact about the continuous spell of study belongs to Admission.
/// Twelve years of school is one Person, one Student, one Admission and twelve
/// thin Enrollment rows — with **zero** demographic fields copied into any of
/// them (INV-ENR-012). If a change ever seems to need a name or a date of birth
/// here, the design has broken.
///
/// ## Its own module, not part of admissions
///
/// Admissions is a three-month intake funnel; this is a twelve-year concern.
/// Promotion, examination and corrections all write enrolments and none of them
/// is an admission. The schema holds an `admissionId`; the TypeScript module
/// holds no import of admissions, and the dependency runs one way only.
///
/// See docs/planning/student-admission-enrollment-architecture.md §18.
model Enrollment {
  id String @id @default(uuid(7))

  /// Scope. All three earn their place: one year, one branch, one tenant.
  /// `academicYearId` denormalizes `AcademicUnit.academicYearId` and is kept
  /// honest by the composite foreign key below, not by a service remembering
  /// to check (INV-ENR-010).
  organizationId String
  branchId       String
  academicYearId String

  /// The spell of study this year belongs to.
  admissionId String

  /// **Denormalized on purpose.** Every downstream module needs "this
  /// student's rows" without a three-table join, and the composite key below
  /// makes the denormalization impossible to get wrong.
  studentId String

  /// The placement, for this year only. A change to either **supersedes** the
  /// row; it never edits it.
  programId      String
  academicUnitId String

  /// Position in a class register. Mutable until the class list locks, and
  /// never an identifier: it is not a foreign key anywhere, it is not allocated
  /// by the numbering engine, and it commonly changes every year.
  rollNumber String?

  enrollmentKind   EnrollmentKind   @default(PRIMARY)
  enrollmentStatus EnrollmentStatus @default(PENDING)

  /// Same academic unit as the previous year.
  isRepeat Boolean @default(false)

  /// Written by Examination alone (INV-ENR-013). Owning the column is not
  /// owning the decision.
  resultOutcome EnrollmentResultOutcome?

  originType EnrollmentOriginType

  /// Provenance, in both directions, so a chain reads from either end without
  /// either row being rewritten.
  previousEnrollmentId String?
  /// Unique: a replacement row is claimed by at most one predecessor, so a
  /// concurrent double correction cannot produce two rows pointing at one
  /// successor.
  supersededById String? @unique
  changeReason   String?

  /// **Provenance only.** Nullable, non-unique, and no cascade — one applicant
  /// may sit behind a whole school career, and an applicant's lifecycle must
  /// never reach the academic record.
  applicantId String?

  exitDate   DateTime?
  exitReason AdmissionExitReason?

  /// Optimistic lock. A bulk promotion and an administrator editing the same
  /// placement cannot both win; the second gets `STALE_ENROLLMENT_VERSION`.
  version Int @default(1)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// One foreign key, two invariants: this enrolment's student is always its
  /// admission's student (INV-ENR-003) and its branch is always its admission's
  /// branch (INV-ENR-004). Both become unrepresentable in Postgres rather than
  /// merely checked in a service someone might forget to call.
  admission Admission @relation(fields: [admissionId, studentId, branchId], references: [id, studentId, branchId])

  /// The same trick for academic structure: the unit must belong to this
  /// branch, this programme and this year (INV-ENR-010, §28.3). Service checks
  /// still run so the caller gets a named error, but the database is what makes
  /// the combination impossible.
  academicUnit AcademicUnit @relation(fields: [academicUnitId, branchId, programId, academicYearId], references: [id, branchId, programId, academicYearId])

  /// And the programme must belong to this branch.
  program Program @relation(fields: [programId, branchId], references: [id, branchId])

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  /// `Restrict`, not `SetNull` and never `Cascade`: an application that a
  /// student's whole school career descends from is not deletable, and quietly
  /// nulling the pointer would erase the provenance instead of refusing the
  /// deletion.
  applicant Applicant? @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  previousEnrollment Enrollment?  @relation("EnrollmentChain", fields: [previousEnrollmentId], references: [id])
  nextEnrollments    Enrollment[] @relation("EnrollmentChain")
  supersededBy       Enrollment?  @relation("EnrollmentSupersede", fields: [supersededById], references: [id])
  supersedes         Enrollment?  @relation("EnrollmentSupersede")

  /// Propagated to Attendance, Marks and Fees, so a downstream row can never
  /// name a student who is not in the enrolment it points at.
  @@unique([id, studentId])

  /// The current-enrolment probe — the hottest query in the system, and the
  /// reason Student carries no `currentEnrollmentId`.
  @@index([studentId, academicYearId, enrollmentStatus])
  /// The class list — the second hottest, and what attendance, examination and
  /// the timetable will all read.
  @@index([academicUnitId, academicYearId, enrollmentStatus])
  @@index([admissionId, academicYearId])
  @@index([studentId, createdAt])
  @@index([branchId, academicYearId, enrollmentStatus])
  @@index([programId, academicYearId])
  @@index([previousEnrollmentId])
  @@index([organizationId])
  @@index([applicantId])
  // INV-ENR-002 (one live PRIMARY per admission per year), INV-ENR-007 (roll
  // number unique in a class list) and the supersede/provenance CHECKs are raw
  // SQL in the migration — Prisma expresses none of them.
}


// --- FROM: modules/identity/address.prisma ---

/// The four address purposes S2 resolves. See
/// docs/planning/core-admission-lifecycle-specification.md §10.4.
///
/// COMMUNICATION falls back to CURRENT when unset. BILLING resolves through
/// the ward's financial guardian, then their CURRENT — that step depends on
/// Guardian being linked to Person, which has not happened yet (Guardian has
/// no personId), so BILLING resolution here stops at direct/CURRENT fallback
/// until that migration lands.
enum AddressType {
  PERMANENT
  CURRENT
  COMMUNICATION
  BILLING
}

/// Whether a PersonAddress link has been confirmed. `REQUIRES BUSINESS
/// DECISION` (§10.7 A2) on whether a portal-submitted change should take
/// effect immediately or propose-then-approve; there is no portal write path
/// yet, so every row today is written by staff and verified immediately.
enum AddressVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Immutable value object — a physical location, never a person's current
/// truth. Sharing and de-duplication both fall out of immutability: a family
/// of four at one address is one `Address` row and four `PersonAddress`
/// links, de-duplicated on `normalizedHash`.
///
/// Never updated after creation — no `updatedAt`, no update path anywhere in
/// the service layer. A move creates a new `Address` and closes/opens
/// `PersonAddress` links; editing this row in place would retroactively
/// change every certificate that ever printed it.
///
/// See docs/planning/core-admission-lifecycle-specification.md §10.3, §10.6.
model Address {
  id             String @id @default(uuid(7))
  organizationId String

  line1       String
  line2       String?
  landmark    String?
  city        String
  district    String?
  state       String
  countryCode String  @default("IN")
  pincode     String

  latitude  Float?
  longitude Float?

  /// SHA-256 hex digest of the canonicalized fields (trimmed, case-folded,
  /// whitespace-collapsed line1/line2/landmark/city/district/state/
  /// countryCode/pincode). A comparison/dedup key only — never rendered.
  normalizedHash String

  createdAt DateTime @default(now())

  personAddresses PersonAddress[]

  @@unique([organizationId, normalizedHash])
  @@index([organizationId])
}

/// Append-only link between a Person and an Address, carrying the semantic
/// type and validity window. History survives because the Address itself is
/// immutable and this link is never edited in place — only closed (`validTo`)
/// and a new one opened. Two people sharing a home are two links to one
/// Address row; a move is one new Address and one new link per affected
/// person.
///
/// See docs/planning/core-admission-lifecycle-specification.md §10.3, §10.5,
/// §10.6.
model PersonAddress {
  id             String @id @default(uuid(7))
  organizationId String
  personId       String
  addressId      String

  addressType AddressType

  validFrom DateTime  @default(now())
  validTo   DateTime?

  verificationStatus AddressVerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?

  /// No FK — Documents (S3) does not exist yet. Same precedent as
  /// Student.photoDocumentId: the column compiles and migrates whether or
  /// not S3 exists, and gains a foreign key only once it does.
  proofDocumentId String?

  /// Free-text, human-written. The system cannot distinguish a corrected typo
  /// from a genuine relocation after the fact — both produce a new Address
  /// and a new link — so this is the only place that distinction lives.
  changeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person  Person  @relation(fields: [personId], references: [id])
  address Address @relation(fields: [addressId], references: [id])

  @@index([personId])
  @@index([organizationId])
  @@index([addressId])
}


// --- FROM: modules/identity/data-key.prisma ---

/// One data-encryption key per organization, stored only in wrapped form.
///
/// Envelope encryption: the DEK encrypts the tenant's sensitive values, and the
/// DEK itself is encrypted ("wrapped") by a key-encryption key. Rotating a KEK
/// then re-wraps N small rows instead of re-encrypting every record, the blast
/// radius of a compromised DEK is one tenant, and offboarding a tenant becomes
/// a key deletion rather than a table scan.
///
/// **The DEK is never stored.** Only its wrapped forms. It exists in process
/// memory for the duration of an operation and is never logged.
///
/// ## Two wraps, and why the second one is asymmetric
///
/// `dekWrappedOperational` is produced with a symmetric key the server holds
/// (`ENCRYPTION_KEY`). That is the wrap used on every request.
///
/// `dekWrappedRecovery` is produced with the **public half** of a recovery
/// keypair. The private half never exists on the server, so a full server
/// compromise yields the operational key only and the recovery path survives
/// the breach. Encryption needs the public key alone, which is why the server
/// can produce this wrap without ever holding recovery secret material.
///
/// Generating that keypair and custodying its private half is an operational
/// ceremony, not something the application may invent — see
/// docs/core/key-custody.md.
model OrganizationDataKey {
  id             String @id @default(uuid(7))
  organizationId String @unique

  /// Wrapped with the symmetric operational KEK. Always present.
  dekWrappedOperational Bytes
  operationalKekVersion Int

  /// Wrapped with the recovery KEK's public half.
  ///
  /// Nullable only so a deployment without established recovery custody can
  /// still run in development. A key in that state is `PENDING_RECOVERY_CUSTODY`
  /// and is refused in production: the alternative is claiming a recovery
  /// guarantee the deployment cannot honour.
  dekWrappedRecovery Bytes?
  recoveryKekVersion Int?

  /// Explicit, so a future change of algorithm is legible in the data rather
  /// than implied by the code that happens to be deployed.
  algorithm String @default("AES-256-GCM")

  status DataKeyStatus @default(PENDING_RECOVERY_CUSTODY)

  createdAt       DateTime  @default(now())
  /// Last KEK rotation. Distinct from a DEK rotation, which re-encrypts data.
  lastRewrappedAt DateTime?

  /// Tenant offboarding. Irreversible: with no wraps left the DEK is
  /// unrecoverable and every ciphertext under it is permanently unreadable.
  shreddedAt DateTime?
  shreddedBy String?

  @@index([status])
}

/// Append-only record of every key rotation and shred.
///
/// KEK rotation and DEK rotation are routinely confused and have very different
/// costs — one re-wraps N rows, the other re-encrypts every encrypted row for
/// the tenant. Recording which happened, and why, is what makes a later
/// investigation possible.
model DataKeyRotationLog {
  id             String @id @default(uuid(7))
  organizationId String

  /// `KEK_REWRAP` or `DEK_ROTATE` or `SHRED`.
  rotationType String
  fromVersion  Int?
  toVersion    Int?
  /// Mandatory.
  reason       String

  performedBy String
  performedAt DateTime @default(now())

  @@index([organizationId])
}


// --- FROM: modules/identity/identity.enums.prisma ---

/// The government identifier kinds this deployment understands.
///
/// Only AADHAAR is handled in v1 — F1 §3.4 classifies it as the one identifier
/// needing ciphertext, blind index and a last-4 display form. APAAR, ABC, PEN,
/// Saral and UDISE ids are institutional identifiers designed to be shared and
/// printed; they stay plaintext on the record that owns them and never reach
/// this table.
enum GovernmentIdType {
  AADHAAR
}

/// Lifecycle of an organization's data-encryption key.
///
/// `PENDING_RECOVERY_CUSTODY` is not in F1's original set and is the honest
/// answer to an unfinished deployment: the DEK exists and works, but it has
/// only one wrap, so losing `KEK_operational` would lose the data. A key in
/// this state is refused outright in production — the application must not
/// pretend a recovery path exists when it does not.
enum DataKeyStatus {
  PENDING_RECOVERY_CUSTODY
  ACTIVE
  ROTATING
  RETIRED
  SHREDDED
}

/// The outcome a human recorded for a candidate pair.
///
/// Only DISTINCT is ever written. The opposite conclusion is not a decision
/// row — it is a merge, and merge execution is deliberately not built yet.
enum MatchDecision {
  DISTINCT
}

/// The permanent lifecycle of a learner identity.
///
/// Distinct from the applicant, admission and enrollment lifecycles: those
/// describe an attempt, a spell of study and a year's placement. This describes
/// the person's standing with the institution, and it outlives all three.
///
/// There is no `DELETED`. Leaving is a status; deletion is not a lifecycle
/// operation, and `ARCHIVED` is a write lock rather than a disappearance —
/// archived students stay searchable and reportable.
///
/// See docs/planning/student-admission-enrollment-architecture.md §19.
enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  EXPELLED
  ARCHIVED
}

/// How a learner identity came into existence.
///
/// The distinction matters because it is the only thing that licenses a null
/// `sourceApplicantId`: every student born through admission has an
/// application behind them, and one that does not is a migrated record.
enum StudentCreationMode {
  ADMISSION
  MIGRATION
}


// --- FROM: modules/identity/person.prisma ---

/// "Is this the same human?" — and nothing else.
///
/// A deduplication index with no lifecycle, no status and no behaviour of its
/// own. It holds only *matching keys*: values whose sole purpose is deciding
/// whether two records describe one person.
///
/// It does not own names for display, addresses, photographs, contact details,
/// or any attribute a user edits. Those belong to Applicant (a frozen legal
/// snapshot of what was declared), Student (current official truth) and
/// Guardian (current truth) — three records that legitimately diverge over
/// time.
///
/// The sprawl rule: the moment Person exists there is pressure to move "just
/// the name" onto it, then the photo, then the address. Every one of those
/// varies per role, which is precisely what Person must not do. A change adding
/// a display or contact attribute here is a design error, not a convenience.
///
/// See docs/planning/01-identity-core/01-person.md and
/// docs/planning/student-admission-enrollment-architecture.md §11.2.
model Person {
  id String @id @default(uuid(7))

  /// Person never spans tenants. The same human at two organizations is two
  /// Persons, by design — a global registry would let one tenant discover
  /// another's students by probing an identifier.
  organizationId String

  /// Blind index over the government identifier:
  /// `HMAC-SHA256(pepper, organizationId + ":" + domain + ":" + normalized)`.
  ///
  /// The organization id is inside the *message*, not merely the query scope,
  /// so the same human at two tenants produces unrelated digests and the index
  /// cannot correlate people across organizations even by direct comparison.
  ///
  /// Null until an identifier is supplied. Postgres treats NULLs as distinct,
  /// so any number of people may have none.
  govtIdHash String?

  /// Blind index over the contact number, last 10 digits. A weak signal: one
  /// household mobile routinely serves every child.
  phoneHash String?

  /// The primary discriminator between same-named people, and required because
  /// a nullable one would silently degrade every medium- and low-confidence
  /// match.
  dob DateTime

  /// Case-folded, punctuation-stripped, whitespace-collapsed. Never rendered to
  /// a user — it exists to be compared, not read.
  nameNormalized String

  /// Non-null means this row is retired and `mergedIntoPersonId` names its
  /// survivor. Merge execution is not built yet; the column exists so a stale
  /// reference will resolve rather than dangle once it is.
  mergedIntoPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sensitive       PersonSensitive?
  student         Student?
  applicants      Applicant[]
  addresses       PersonAddress[]
  guardianProfiles Guardian[]
  /// Relationships where this Person is the guardian.
  guardianOf      Guardianship[] @relation("GuardianOf")
  /// Relationships where this Person is the ward (child).
  wardOf          Guardianship[] @relation("WardOf")
  mergedInto      Person?  @relation("PersonMerge", fields: [mergedIntoPersonId], references: [id])
  mergedFrom      Person[] @relation("PersonMerge")

  /// The rule that resolves the two-branch collision: a child confirmed at two
  /// branches resolves to one Person, so the second admission fails on
  /// Student's own uniqueness rather than quietly creating a second identity.
  @@unique([organizationId, govtIdHash])
  @@index([organizationId, phoneHash, dob])
  @@index([organizationId, nameNormalized, dob])
  @@index([mergedIntoPersonId])
  // There is deliberately no `deletedAt`. Historical records point at this row,
  // and a Person whose sensitive data has been erased still deduplicates —
  // which is what stops an erased subject re-enrolling as a stranger.
}

/// Ciphertext for the one identifier that needs it.
///
/// Split from Person so the matching index can be read freely while the
/// recoverable value sits behind a separate table with its own access rules.
/// The blind index stays on Person because it *is* a matching key; the
/// ciphertext is not, and nothing should join to it to answer "same human?".
model PersonSensitive {
  id             String @id @default(uuid(7))
  personId       String @unique
  organizationId String

  idType GovernmentIdType

  /// AES-256-GCM. Authenticated, so tampering fails loudly rather than
  /// returning plausible garbage.
  ///
  /// Nullable because crypto-erasure nulls it in place: the Person row, the
  /// academic record and every foreign key survive; only the recoverable value
  /// goes. See §24.
  aadhaarEnc Bytes?

  /// The last four digits, for routine screen display without decrypting.
  /// Rendered as `XXXX XXXX 1234`.
  aadhaarLast4 String?

  /// Which DEK generation produced the ciphertext. Decrypt has to know, or a
  /// key rotation invalidates every existing row.
  keyVersion Int

  /// Set when the value has been crypto-erased. The row remains so the erasure
  /// itself is evidence.
  erasedAt DateTime?
  erasedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// A human reviewed two candidates and judged them different people.
///
/// Without this the same twin warning fires at every step of every year, and
/// staff learn to dismiss all warnings reflexively — which destroys the value
/// of the ones that matter.
model PersonMatchDecision {
  id             String @id @default(uuid(7))
  organizationId String

  /// Stored with `personAId < personBId` so the pair is order-independent and
  /// one comparison cannot be recorded twice under two spellings.
  personAId String
  personBId String

  decision   MatchDecision
  /// Mandatory. "Twins", "father and son, same name" — the reason is what makes
  /// the decision reviewable later.
  reason     String
  decidedBy  String
  decidedAt  DateTime      @default(now())

  @@unique([personAId, personBId])
  @@index([organizationId])
}

/// Append-only evidence of a completed merge.
///
/// Merge is irreversible, so the evidence has to be reconstructable after the
/// fact: repointing the references destroys the information about which side
/// they came from.
///
/// **Nothing writes to this table yet.** Merge execution is deliberately
/// deferred; the log exists so the operation is possible to add without a
/// migration that touches live identity data.
model PersonMergeLog {
  id             String @id @default(uuid(7))
  organizationId String

  survivorPersonId String
  mergedPersonId   String

  /// Mandatory.
  reason String

  /// `{"applicant": [...], "student": [...], "guardian": [...]}` — exactly what
  /// moved. Without it, "which records used to belong to the other person?" is
  /// unanswerable.
  repointedRefs Json

  mergedBy String
  mergedAt DateTime @default(now())

  @@index([organizationId])
  @@index([survivorPersonId])
  @@index([mergedPersonId])
}


// --- FROM: modules/identity/student.prisma ---

/// The permanent learner identity within one organization.
///
/// Student answers "is this human an institutional learner here?" — where
/// Person answers "is this the same human?". Both are needed: one human is
/// routinely a student, a guardian and an employee, and only Person can say
/// they are one human.
///
/// ## What Student deliberately does not hold
///
/// Every field passes the placement test: *what does this fact vary with?*
/// Anything that varies with the academic year, the class, the section or the
/// programme belongs to Enrollment, and anything that varies with the spell of
/// study belongs to Admission. If a field would have to be **copied** when a
/// student is promoted, it is in the wrong table.
///
/// So there is no `academicYearId`, no `programId`, no `academicUnitId`, no
/// `rollNumber` — and no `currentEnrollmentId`. That last one looks harmless
/// and is not: it needs maintaining on every promotion, correction, transfer,
/// supersede and cancel, and each of those is a chance to leave it stale while
/// looking authoritative. The execution context always carries an academic
/// year, so "current placement" is a one-row indexed query rather than a
/// pointer somebody has to remember to update.
///
/// There is also no `userId`. A student identity exists whether or not the
/// learner can log in, and junior classes usually cannot.
///
/// And no Aadhaar. Phase 1 established `PersonSensitive` as the single owner of
/// sensitive identity; a second copy here would be a second thing to erase.
///
/// See docs/planning/student-admission-enrollment-architecture.md §11.
model Student {
  id String @id @default(uuid(7))

  /// Identity scope. Immutable — a Student never silently moves between
  /// tenants. A genuine cross-organization move is a migration that mints a new
  /// Student in the target, because Person and studentCode are both
  /// organization-scoped and the academic structure belongs to the source.
  organizationId String

  /// A **mutable pointer**, not identity.
  ///
  /// It exists so a branch-scoped list does not need a join through Admission.
  /// A branch transfer moves it; the immutable truth of where a spell of study
  /// happened lives on Admission, whose `branchId` never changes.
  ///
  /// `[id, branchId]` is deliberately never declared unique: a composite
  /// foreign key on a mutable column would break every child row the moment a
  /// student transfers.
  branchId String

  /// The human. Immutable.
  ///
  /// Unique on its own as well as within the organization. The two overlap, and
  /// deliberately: `@@unique([organizationId, personId])` is the invariant the
  /// architecture names, and it stays because it survives a corrupted
  /// `organizationId`; this column-level constraint is what makes the relation
  /// one-to-one rather than one-to-many, so a reader sees `Person.student`
  /// instead of `Person.students[]` and cannot be misled about the cardinality.
  /// It is strictly stronger — a Person never spans tenants, so "one Student
  /// per Person" and "one Student per Person per organization" say the same
  /// thing.
  personId String @unique

  /// The human-facing identifier: permanent, organization-scoped, and
  /// encoding nothing that can become false.
  ///
  /// Allocated once from the central numbering engine and then **persisted, not
  /// derived**. Changing a numbering format next year must never alter an ID
  /// card printed this year, so nothing recomputes this value — not from the
  /// sequence, not from the id, not from the creation date.
  ///
  /// It is never a foreign key. Other modules reference `id`.
  studentCode String

  status StudentStatus @default(ACTIVE)

  // --- Current official demographics ---------------------------------------
  //
  // Deliberately a separate copy from Applicant's, which is a frozen legal
  // snapshot of what was declared on a date. A name corrected by affidavit in
  // 2029 must not silently rewrite the 2026 application form. Two facts that
  // happen to start equal and legitimately diverge.

  firstName   String
  middleName  String?
  lastName    String
  /// Derived from the name parts on write. Carries the trigram index that
  /// serves fuzzy search.
  displayName String

  dob DateTime

  genderId       String
  religionId     String?
  casteId        String?
  categoryId     String?
  motherTongueId String?
  bloodGroupId   String?

  disabilityStatus Boolean @default(false)
  disabilityTypeId String?
  disabilityNotes  String?

  // --- Contact -------------------------------------------------------------
  //
  // The student's *own* contact, which an adult learner has and a five-year-old
  // does not. A guardian's number is reached through Guardianship and is not
  // copied here.

  primaryMobile String?
  /// Last ten digits, non-digits stripped. Stored because search-by-mobile has
  /// to match `+91 98765 43210`, `098765 43210` and `9876543210` as one number,
  /// and normalising at query time cannot use an index.
  mobileNormalized String?
  primaryEmail     String?

  // --- Institutional identifiers -------------------------------------------
  //
  // Plaintext by design (F1 D5). These are issued to be shared between
  // institutions and printed on records — they are personal data, not secrets,
  // and encrypting them would add key-loss risk while buying nothing.

  apaarId        String?
  abcId          String?
  penNo          String?
  saralId        String?
  udiseStudentId String?

  /// A reference, never a blob. Student is not a document store; the Document
  /// module owns the file, its scanning, its versioning and its access rules.
  /// No foreign key, so Student compiles and migrates whether or not S3 exists.
  photoDocumentId String?

  // --- Provenance ----------------------------------------------------------

  createdVia StudentCreationMode

  /// Which application produced this student.
  ///
  /// Null only for a migrated student, enforced by a CHECK. A partial unique
  /// index makes "one applicant produces at most one Student" a database fact
  /// rather than a convention two concurrent requests can break.
  sourceApplicantId String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Present for schema consistency and **never set by any Student code path**.
  /// Leaving is a lifecycle status; deletion is not a lifecycle operation.
  deletedAt DateTime?

  admissions     Admission[]
  /// Reachable through Admission too, but held directly so a downstream module
  /// can ask "this student's placements" without a three-table join.
  enrollments    Enrollment[]

  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  person         Person       @relation(fields: [personId], references: [id])
  gender         Gender       @relation(fields: [genderId], references: [id])
  religion       Religion?    @relation(fields: [religionId], references: [id])
  caste          Caste?       @relation(fields: [casteId], references: [id])
  category       Category?    @relation(fields: [categoryId], references: [id])
  motherTongue   Language?    @relation(fields: [motherTongueId], references: [id])
  bloodGroup     BloodGroup?  @relation(fields: [bloodGroupId], references: [id])
  disabilityType Disability?  @relation(fields: [disabilityTypeId], references: [id])

  /// The identity invariant. Also the last line of defence against a numbering
  /// bug: a duplicate code cannot reach the database even if the generator
  /// produced one.
  @@unique([organizationId, studentCode])
  /// One Student per human per organization. This is what resolves the
  /// two-branch collision — a child confirmed at Mumbai and at Pune resolves to
  /// one Person, so the second admission fails here rather than quietly
  /// creating a second identity.
  @@unique([organizationId, personId])
  /// Enables composite references from child tables that must not be able to
  /// name a student in another tenant.
  @@unique([id, organizationId])

  @@index([organizationId, branchId, status])
  @@index([organizationId, mobileNormalized])
  @@index([organizationId, dob])
  @@index([sourceApplicantId])
  @@index([personId])

  /// Prefix and case-insensitive search on the code.
  ///
  /// Trigram rather than `text_pattern_ops`: the latter is the textbook answer
  /// for `LIKE 'STU0001%'`, but Prisma cannot round-trip a btree carrying a
  /// non-default operator class, so declaring one leaves the drift gate
  /// permanently red. Trigram serves the same prefix query, additionally serves
  /// `ILIKE`, and matches the index already used for names — one mechanism for
  /// both text searches instead of two.
  ///
  /// Exact lookup does not touch this index; it uses the unique constraint.
  @@index([studentCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_code_trgm_idx")

  /// Fuzzy name search. Requires `pg_trgm`, installed by the Phase 0 migration.
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "student_display_name_trgm_idx")

  // The partial unique index on `sourceApplicantId` and the CHECK constraints
  // are raw SQL in the migration — Prisma expresses neither, and its drift
  // check ignores both.
}


// --- FROM: modules/numbering/numbering.enums.prisma ---

/// Where a sequence's uniqueness and counter live.
///
/// Identity numbers (`STUDENT_CODE`, `EMPLOYEE_CODE`) are ORGANIZATION-scoped so
/// they survive a branch transfer; operational numbers are BRANCH-scoped because
/// their meaning is local to the branch that issued them.
enum SequenceScope {
  ORGANIZATION
  BRANCH
}

/// How strongly a sequence guarantees continuity.
///
/// MONOTONIC allocates in its own short transaction and commits immediately, so
/// a caller that later rolls back burns the number and leaves a gap. Gaps in a
/// student code are cosmetic; the absence of contention is not.
///
/// GAPLESS allocates inside the caller's transaction and rolls back with it, so
/// the counter row stays locked until the caller commits. That serialises the
/// purpose for its scope, which is the correct price for a receipt or invoice
/// series an auditor will check for continuity.
enum AllocationMode {
  MONOTONIC
  GAPLESS
}

/// The closed set of business identifiers this engine issues.
///
/// An enum rather than a free string: a typo previously created a second,
/// silently parallel sequence rather than failing.
enum SequencePurpose {
  STUDENT_CODE
  EMPLOYEE_CODE
  ADMISSION_NO
  ADMISSION_FORM
  APPLICATION
  RECEIPT
  INVOICE
  TC_NUMBER
  CERTIFICATE
}

/// Whether a sequence restarts each academic year.
///
/// NEVER keeps one counter for the life of the tenant and is what makes an
/// identity number permanent. YEARLY keys the counter on the academic year.
enum ResetStrategy {
  NEVER
  YEARLY
}


// --- FROM: modules/numbering/numbering.prisma ---

/// One engine issues every human-facing business identifier in the ERP.
///
/// It does not own primary keys — those are UUID v7 and are never generated
/// here — and it does not own whether a generated value is unique at its
/// destination. Uniqueness is enforced by the destination table's own
/// constraint, so a generator bug surfaces as a rejected insert rather than as
/// two students sharing a code.
///
/// See docs/planning/student-admission-enrollment-architecture.md §34.
model NumberSequenceConfig {
  id             String          @id @default(uuid(7))
  organizationId String
  /// Null when `scope = ORGANIZATION`. A CHECK constraint keeps the two in step.
  branchId       String?
  scope          SequenceScope
  purpose        SequencePurpose
  allocationMode AllocationMode  @default(MONOTONIC)

  prefix              String?
  suffix              String?
  includeBranchCode   Boolean @default(false)
  includeAcademicYear Boolean @default(false)
  sequencePadding     Int     @default(4)
  /// Must contain `{sequence}`; validated at create and update. Without it every
  /// generated value is identical and the failure surfaces as a confusing
  /// unique violation at the destination.
  format              String

  resetStrategy ResetStrategy @default(NEVER)
  isActive      Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  counters NumberSequenceCounter[]

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, purpose])
  // Uniqueness is two partial indexes — one per scope — declared in raw SQL
  // because Prisma cannot express a partial unique index. See the migration.
}

/// The allocated position of a sequence, one row per config per reset window.
///
/// `academicYearId` is null for `resetStrategy = NEVER`. Postgres treats NULLs
/// as distinct, so the obvious `@@unique([configId, academicYearId])` does not
/// constrain those rows at all — every allocation would insert a fresh counter
/// returning 1 and issue duplicate codes indefinitely. Uniqueness is therefore a
/// functional index over a coalesced year, declared in raw SQL in the migration.
model NumberSequenceCounter {
  id             String   @id @default(uuid(7))
  configId       String
  academicYearId String?
  currentValue   Int      @default(0)
  updatedAt      DateTime @updatedAt

  config NumberSequenceConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}



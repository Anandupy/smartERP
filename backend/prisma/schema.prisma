// --- FROM: modules/numbering/numbering.enums.prisma ---

/// Where a sequence's uniqueness and counter live.
///
/// Identity numbers (`STUDENT_CODE`, `EMPLOYEE_CODE`) are ORGANIZATION-scoped so
/// they survive a branch transfer; operational numbers are BRANCH-scoped because
/// their meaning is local to the branch that issued them.
enum SequenceScope {
  ORGANIZATION
  BRANCH
}

/// How strongly a sequence guarantees continuity.
///
/// MONOTONIC allocates in its own short transaction and commits immediately, so
/// a caller that later rolls back burns the number and leaves a gap. Gaps in a
/// student code are cosmetic; the absence of contention is not.
///
/// GAPLESS allocates inside the caller's transaction and rolls back with it, so
/// the counter row stays locked until the caller commits. That serialises the
/// purpose for its scope, which is the correct price for a receipt or invoice
/// series an auditor will check for continuity.
enum AllocationMode {
  MONOTONIC
  GAPLESS
}

/// The closed set of business identifiers this engine issues.
///
/// An enum rather than a free string: a typo previously created a second,
/// silently parallel sequence rather than failing.
enum SequencePurpose {
  STUDENT_CODE
  EMPLOYEE_CODE
  ADMISSION_NO
  ADMISSION_FORM
  APPLICATION
  RECEIPT
  INVOICE
  TC_NUMBER
  CERTIFICATE
}

/// Whether a sequence restarts each academic year.
///
/// NEVER keeps one counter for the life of the tenant and is what makes an
/// identity number permanent. YEARLY keys the counter on the academic year.
enum ResetStrategy {
  NEVER
  YEARLY
}


// --- FROM: modules/numbering/numbering.prisma ---

/// One engine issues every human-facing business identifier in the ERP.
///
/// It does not own primary keys — those are UUID v7 and are never generated
/// here — and it does not own whether a generated value is unique at its
/// destination. Uniqueness is enforced by the destination table's own
/// constraint, so a generator bug surfaces as a rejected insert rather than as
/// two students sharing a code.
///
/// See docs/planning/student-admission-enrollment-architecture.md §34.
model NumberSequenceConfig {
  id             String          @id @default(uuid(7))
  organizationId String
  /// Null when `scope = ORGANIZATION`. A CHECK constraint keeps the two in step.
  branchId       String?
  scope          SequenceScope
  purpose        SequencePurpose
  allocationMode AllocationMode  @default(MONOTONIC)

  prefix              String?
  suffix              String?
  includeBranchCode   Boolean @default(false)
  includeAcademicYear Boolean @default(false)
  sequencePadding     Int     @default(4)
  /// Must contain `{sequence}`; validated at create and update. Without it every
  /// generated value is identical and the failure surfaces as a confusing
  /// unique violation at the destination.
  format              String

  resetStrategy ResetStrategy @default(NEVER)
  isActive      Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  counters NumberSequenceCounter[]

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, purpose])
  // Uniqueness is two partial indexes — one per scope — declared in raw SQL
  // because Prisma cannot express a partial unique index. See the migration.
}

/// The allocated position of a sequence, one row per config per reset window.
///
/// `academicYearId` is null for `resetStrategy = NEVER`. Postgres treats NULLs
/// as distinct, so the obvious `@@unique([configId, academicYearId])` does not
/// constrain those rows at all — every allocation would insert a fresh counter
/// returning 1 and issue duplicate codes indefinitely. Uniqueness is therefore a
/// functional index over a coalesced year, declared in raw SQL in the migration.
model NumberSequenceCounter {
  id             String   @id @default(uuid(7))
  configId       String
  academicYearId String?
  currentValue   Int      @default(0)
  updatedAt      DateTime @updatedAt

  config NumberSequenceConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}



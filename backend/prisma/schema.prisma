  @@index([expiresAt])
  @@index([organizationId])
  @@index([branchId])
}


// --- FROM: modules/communication/provider-config.prisma ---

model ProviderConfig {
  id              String       @id @default(uuid(7))
  organizationId  String?
  branchId        String?

  provider        ProviderType
  channel         CommunicationChannel
  name            String

  isPrimary       Boolean      @default(false)
  isActive        Boolean      @default(true)

  /// Provider configuration (host, port, auth, apiKey, senderId, ...).
  ///
  /// NOT encrypted. No code reads or writes this column yet; the provider
  /// integration is unimplemented. Before the first write, encrypt at rest with
  /// ENCRYPTION_KEY — see docs/core/configuration.md.
  credentials     Json
  settings        Json?        // Additional provider-specific settings

  createdBy       String?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, branchId, provider, channel, name])
  @@index([organizationId])
  @@index([branchId])
  @@index([provider])
  @@index([channel])
}



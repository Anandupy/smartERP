  route           String?
  executionTime   Int?

  severity        String    @default("INFO")
  status          String    @default("SUCCESS")

  metadata        Json?
  changes         Json?

  @@index([timestamp])
  @@index([userId])
  @@index([module])
  @@index([aggregateType, aggregateId])
  @@index([action])
  @@index([organizationId])
  @@index([branchId])
  @@index([academicYearId])
  @@index([requestId])
}



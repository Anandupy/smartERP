# =============================================================================
# CampusFlow ERP — Backend Environment Template
# =============================================================================
# Copy to `.env` and fill in real values. Every variable below is validated at
# startup by src/config/env.validation.ts; the process refuses to boot on an
# invalid or insecure configuration.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
PORT=3000

# --- Database ----------------------------------------------------------------
# Must be a postgresql:// connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/erp?schema=public"

# --- Authentication ----------------------------------------------------------
# REQUIRED. Minimum 32 characters in production. Must differ from each other.
# Well-known placeholders ("secret", "changeme", "super-secret", ...) are rejected.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes, formatted as <number><s|m|h|d>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Reserved for encryption of stored provider credentials. Not consumed yet;
# validated only when present (minimum 32 characters).
# ENCRYPTION_KEY=

# --- Bootstrap seeding -------------------------------------------------------
# Seeding never runs automatically in production. Outside production it runs by
# default; set SEED_ON_BOOTSTRAP=false to disable, or true to force it on.
# When enabled, ADMIN_EMAIL and ADMIN_PASSWORD are both required.
SEED_ON_BOOTSTRAP=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- HTTP --------------------------------------------------------------------
# Comma-separated origin allow-list. REQUIRED in production.
# Leave unset outside production to allow all origins.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Throttling (in-memory; no Redis required) -------------------------------
# Trust X-Forwarded-For. Enable ONLY behind a proxy you control: without one,
# a client can forge its own source address and defeat IP-based rate limiting.
TRUST_PROXY=false

# Set THROTTLE_ENABLED=false to disable rate limiting entirely (tests only).
THROTTLE_ENABLED=true

# Global default bucket: requests per TTL window (seconds), per client IP.
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Credential endpoints (login, refresh): brute-force / credential-stuffing bucket.
THROTTLE_AUTH_TTL=300
THROTTLE_AUTH_LIMIT=10

# OTP issue/verify endpoints: OTP abuse bucket.
THROTTLE_OTP_TTL=300
THROTTLE_OTP_LIMIT=5

# Password reset request/consume endpoints: reset abuse bucket.
THROTTLE_PASSWORD_RESET_TTL=900
THROTTLE_PASSWORD_RESET_LIMIT=5

# --- Logging -----------------------------------------------------------------
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Directory for app.log / error.log. Defaults to <cwd>/logs.
# LOG_DIR=./logs

# --- Identity & sensitive data -------------------------------------------
#
# Consumed as of Phase 1. See docs/core/key-custody.md before setting these in
# any environment that will hold real data — two of them can never be changed
# once identity data exists.

# Symmetric key that wraps each organization's data key.
# Must decode to exactly 32 bytes (base64, base64url or hex):
#   openssl rand -base64 32
ENCRYPTION_KEY=<PROVIDE_SECURE_KEY>

# HMAC key for identity blind indexes.
#   openssl rand -base64 48
#
# WARNING: changing this after identity data exists raises no error. It
# silently stops duplicate detection from finding anyone, and every existing
# index becomes unmatchable.
IDENTITY_HASH_PEPPER=<PROVIDE_SECURE_PEPPER>

# PEM PUBLIC key of the recovery keypair — the public half only.
#
# The private half must be generated offline and never placed on a server;
# holding it here would defeat the mechanism entirely, and the application
# refuses to start if a private key is supplied. Required in production.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out recovery-private.pem
#   openssl rsa -in recovery-private.pem -pubout -out recovery-public.pem
# KEK_RECOVERY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# --- Document storage (S3/R5) --------------------------------------------
#
# Only "local" is implemented (a development filesystem adapter). Cloud
# providers (s3, r2, gcs, supabase, ...) are deferred — setting anything
# other than "local" fails at boot naming exactly what is missing. See
# docs/planning/document-management-specification.md.
# DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_LOCAL_ROOT=./storage/documents

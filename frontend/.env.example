# CampusFlow ERP — frontend environment template.
#
# Copy to `.env.local` and adjust. Every variable is validated at boot by
# `src/config/env.ts`; a missing or malformed value fails the build loudly
# instead of surfacing later as an obscure runtime bug. Only `NEXT_PUBLIC_*`
# variables are readable in the browser — never put secrets here.

# --- API ---------------------------------------------------------------------
# Unversioned API root. The version segment is appended separately (below), so
# do NOT include `/v1` here.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend API version segment. The backend versions its surface; the frontend
# resolves every service path against `<NEXT_PUBLIC_API_URL>/<version>` — with
# the values above, `POST /auth/login` resolves to
# `http://localhost:3001/v1/auth/login`. Moving to v2 is a deployment change,
# not a code change. Format: `v` followed by digits (v1, v2, …).
NEXT_PUBLIC_API_VERSION=v1

# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT=30000

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CampusFlow

# Release string shown on brand surfaces (splash, welcome footer).
NEXT_PUBLIC_APP_VERSION=4.2.0

# One of: development | staging | production | test
NEXT_PUBLIC_APP_ENV=development

# --- Admission form scanning (server-only — never NEXT_PUBLIC_) ---------------
# See docs/admission-form-scanning.md. Read only by src/config/server-env.ts.
#
# Which engine reads a scanned admission form:
#   auto    (default) Claude when ANTHROPIC_API_KEY is set, else the offline scanner
#   offline the free offline scanner only — nothing leaves the server
#   claude  Claude vision only (requires ANTHROPIC_API_KEY)
ADMISSION_OCR_ENGINE=auto

# Optional: enables Claude vision (better on messy handwriting; paid per scan).
# ANTHROPIC_API_KEY=

# Optional: folder holding the offline scanner's PaddleOCR model files.
# Defaults to node_modules/@gutenye/ocr-models/assets.
# ADMISSION_OCR_MODEL_DIR=
